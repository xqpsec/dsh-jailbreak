{
  "name": "@xqpsec/dsh-jailbreak",
  "version": "2.1.1",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "通用、零依赖的 LLM 红队请求变换内核：全任务 system-only 注入，保留宿主采样、工具、思考设置与用户格式；支持四种请求协议及可选轻量 HTTP 代理。旧 20 类策略保留为显式实验臂，历史结果不作为新内核效果声明。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "jailbreak",
    "dsh-jailbreak",
    "prompt-injection",
    "prompt-engineering",
    "refusal-reduction",
    "prompt-eval",
    "chain-of-thought",
    "aecot",
    "llm-security",
    "ai-security",
    "red-team",
    "adversarial",
    "refusal-benchmark",
    "reverse-engineering",
    "malware-analysis",
    "ctf",
    "security-research",
    "agent",
    "破甲",
    "越狱评测",
    "红队",
    "提示词越狱",
    "大模型越狱",
    "dsh破甲",
    "pojia"
  ],
  "engines": {
    "node": ">=20"
  },
  "dshTarget": "0.2.1-rc.2",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./bin": "./bin/aecot.js",
    "./kernel": "./lib/kernel.js",
    "./proxy": "./lib/proxy.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "gate.json",
    "scope.txt",
    "icon.svg",
    "SCOPE.md",
    "CHANGELOG.md",
    "LICENSE-GATE",
    "LICENSE-COMMERCIAL.md",
    "NOTICE",
    "lib",
    "bin",
    "locale",
    "docs",
    "eval/forgery-seed.mjs",
    "eval/goals.v1.json",
    "eval/goals.v2.json",
    "eval/goals.heldout.v1.json",
    "eval/goals.collateral.v1.json",
    "eval/goals.knowledge.v1.json",
    "eval/hard-targets.mjs",
    "eval/kernel-ab.mjs",
    "eval/kernel-benign.mjs",
    "eval/kernel-ladder-e2e.mjs",
    "eval/kernel-redteam.mjs",
    "eval/kernel-texts",
    "eval/run-baseline.mjs"
  ],
  "bin": {
    "aecot": "bin/aecot.js",
    "jailbreak": "bin/aecot.js",
    "pojia-kernel": "bin/kernel.js"
  },
  "scripts": {
    "test": "node --test test/anthropic.test.js test/arm.test.js test/cli-help-profile.test.js test/client.test.js test/command.test.js test/compat-arm-section.test.js test/compat-doctor.test.js test/compat-endpoint.test.js test/compat-install.test.js test/compat-preset-route.test.js test/compat-protocol.test.js test/compat-transport-send.test.js test/content-length.test.js test/creative-domain.test.js test/doctor.test.js test/endpoint.test.js test/engine.test.js test/gate.test.js test/hcot.test.js test/hub.test.js test/live.test.js test/plugin.test.js test/policy.test.js test/preset-api.test.js test/presets.test.js test/kernel.test.js test/proxy.test.js test/profile.test.js test/reframe.test.js test/refusal.test.js test/render.test.js",
    "bench:kernel": "node eval/kernel-benign.mjs",
    "gate": "node bin/aecot.js gate",
    "aecot": "node bin/aecot.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xqpsec/dsh-jailbreak.git"
  },
  "homepage": "https://github.com/xqpsec/dsh-jailbreak#readme",
  "bugs": {
    "url": "https://github.com/xqpsec/dsh-jailbreak/issues"
  },
  "author": "xqpsec",
  "contributors": [],
  "publishConfig": {
    "access": "public"
  }
}
