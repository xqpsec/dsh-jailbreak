    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "jailbreak",
    "dsh-jailbreak",
    "jailbreak",
    "prompt-injection",
    "prompt-engineering",
    "refusal-reduction",
    "prompt-eval",
    "chain-of-thought",
    "aecot",
    "llm-security",
    "ai-security",
    "red-team",
    "adversarial",
    "refusal-benchmark",
