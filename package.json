  "bin": {
    "aecot": "./bin/aecot.js",
    "jailbreak": "./bin/aecot.js"
  },
  "scripts": {
    "test": "node --test test/engine.test.js test/plugin.test.js test/hub.test.js test/command.test.js test/render.test.js test/profile.test.js test/arm.test.js test/policy.test.js test/live.test.js test/gate.test.js test/hcot.test.js test/refusal.test.js test/endpoint.test.js test/anthropic.test.js test/doctor.test.js test/client.test.js",
