{
  "version": "1.0.0",
  "profile": "lab",
  "note": "1.1.x beta：阀门默认关闭（enforce:false），所有请求原样注入、行为等同直发；把 enforce 改成 true 立刻恢复拦截，无需改代码。",
  "enforce": false,
  "dryRun": false,
  "onDeny": "passthrough",
  "retryAttempts": 3,
  "preset": "deepseek",
  "targets": {
    "mode": "warn",
    "allowPrivate": true,
    "allowSuffixes": [".localhost", ".lab", ".local", ".test", ".internal", ".lan", ".home.arpa"],
    "allowHosts": [],
    "allowCidrs": [],
    "denyHosts": []
  },
  "categories": {
    "hardDeny": ["payment-fraud", "identity-forgery", "ransomware", "ddos", "credential-theft"],
    "alwaysAllow": ["reverse-engineering", "malware-analysis", "ctf", "lab-eval"]
  },
  "authorization": {
    "file": "scope.txt",
    "maxAgeDays": 365
  }
}
